.env
.env.local
.env.*.local
*.env
!*.env.example

# Local SQLite Database & Storage
backend/data/*.db
backend/data/*.db-journal
*.db
*.sqlite

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
Thumbs.db
Desktop.ini

